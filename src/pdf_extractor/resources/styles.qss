/* PDF信息提取工具 v2.2 — UI 设计规范 (Demo 基准) */

/* ═══════════════ Global ═══════════════ */
* {
    font-family: "Microsoft YaHei", "微软雅黑", "Segoe UI", sans-serif;
    font-size: 14px;
    color: #334155;
}

QMainWindow {
    background-color: #F8FAFC;
}

QDialog {
    background-color: #FFFFFF;
}

/* ═══════════════ Typography ═══════════════ */
QLabel {
    color: #334155;
    background: transparent;
}

QLabel#section-title {
    font-size: 14px;
    font-weight: 600;
    color: #0F172A;
    margin-bottom: 12px;
}

QLabel#card-title {
    font-size: 16px;
    font-weight: 600;
    color: #0F172A;
    margin-bottom: 16px;
}

QLabel#hint-text {
    color: #64748B;
    font-size: 12px;
}

QLabel#stat-value {
    font-size: 18px;
    font-weight: 700;
    color: #0F172A;
}

QLabel#stat-label {
    font-size: 12px;
    color: #64748B;
}

/* ═══════════════ Cards ═══════════════ */
QFrame#card {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    padding: 24px;
}

QFrame#card-compact {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 16px;
}

QFrame#stat-card {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #F8FAFC, stop:1 #F1F5F9);
    border-radius: 10px;
    padding: 16px 20px;
}

/* ═══════════════ Banners (no borders per demo) ═══════════════ */
QLabel#warning-banner {
    background-color: #FEF3C7;
    color: #92400E;
    border-radius: 6px;
    padding: 12px 16px;
    font-size: 13px;
}

QLabel#success-banner {
    background-color: #F0FDF4;
    color: #166534;
    border-radius: 6px;
    padding: 12px 16px;
    font-size: 13px;
}

QLabel#danger-banner {
    background-color: #FEE2E2;
    color: #991B1B;
    border-radius: 6px;
    padding: 12px 16px;
    font-size: 13px;
}

/* ═══════════════ Buttons ═══════════════ */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    padding: 10px 20px;
    color: #334155;
    font-size: 14px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #F8FAFC;
    border-color: #CBD5E1;
}

QPushButton:pressed {
    background-color: #E2E8F0;
}

QPushButton:disabled {
    background-color: #F1F5F9;
    color: #94A3B8;
}

QPushButton#btn-primary {
    background-color: #15803D;
    color: #FFFFFF;
    border: none;
    font-weight: 600;
    padding: 10px 20px;
}

QPushButton#btn-primary:hover {
    background-color: #16A34A;
}

QPushButton#btn-primary:pressed {
    background-color: #166534;
}

QPushButton#btn-primary:disabled {
    background-color: #86EFAC;
    color: #FFFFFF;
}

QPushButton#btn-secondary {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    color: #334155;
    font-weight: 600;
    padding: 10px 20px;
}

QPushButton#btn-secondary:hover {
    background-color: #F8FAFC;
    border-color: #CBD5E1;
}

QPushButton#btn-ghost {
    background: transparent;
    border: 1px solid transparent;
    color: #64748B;
    font-weight: 600;
    padding: 10px 20px;
}

QPushButton#btn-ghost:hover {
    background-color: #F8FAFC;
    border-color: transparent;
    color: #64748B;
}

QPushButton#btn-danger {
    background-color: #DC2626;
    color: #FFFFFF;
    border: none;
    font-weight: 600;
    padding: 10px 20px;
}

QPushButton#btn-danger:hover {
    background-color: #EF4444;
}

QPushButton#btn-small {
    padding: 6px 14px;
    font-size: 12px;
}

/* ═══════════════ Inputs ═══════════════ */
QLineEdit, QComboBox, QSpinBox {
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    padding: 0px 14px;
    min-height: 36px;
    background-color: #FFFFFF;
    color: #334155;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #15803D;
}

QComboBox::drop-down {
    border: none;
}

QComboBox QAbstractItemView {
    border: 1px solid #E2E8F0;
    background: #FFFFFF;
    selection-background-color: #DCFCE7;
    selection-color: #0F172A;
    outline: none;
}

QSpinBox::up-button, QSpinBox::down-button {
    border: none;
    background: #F8FAFC;
    width: 20px;
}

/* ═══════════════ Tables ═══════════════ */
QTableWidget {
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    background-color: #FFFFFF;
    gridline-color: #F1F5F9;
    selection-background-color: #DCFCE7;
    selection-color: #0F172A;
}

QTableWidget::item {
    padding: 10px 16px;
    min-height: 24px;
}

QHeaderView::section {
    background-color: #F8FAFC;
    color: #0F172A;
    font-weight: 700;
    font-size: 13px;
    border: none;
    border-bottom: 1px solid #E2E8F0;
    padding: 10px 16px;
}

/* ═══════════════ Progress Bar ═══════════════ */
QProgressBar {
    border: none;
    border-radius: 4px;
    background-color: #F1F5F9;
    height: 8px;
    text-align: center;
    font-size: 11px;
}

QProgressBar::chunk {
    background-color: #15803D;
    border-radius: 4px;
}

/* ═══════════════ Group Box ═══════════════ */
QGroupBox {
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    margin-top: 12px;
    padding: 16px;
    padding-top: 28px;
    font-weight: 600;
    color: #0F172A;
    background-color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 12px;
}

/* ═══════════════ Scroll Bar ═══════════════ */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #CBD5E1;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #94A3B8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
}

QScrollBar::handle:horizontal {
    background-color: #CBD5E1;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #94A3B8;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ═══════════════ Toolbar ═══════════════ */
QFrame#toolbar {
    background-color: #FFFFFF;
    border-top: 1px solid #F1F5F9;
    padding: 12px 24px;
}

/* ═══════════════ Radio card items ═══════════════ */
QFrame#radio-card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 12px 16px;
}

QFrame#radio-card-selected {
    background: #F0FDF4;
    border: 1px solid #15803D;
    border-radius: 8px;
    padding: 12px 16px;
}

/* ═══════════════ Preview placeholder ═══════════════ */
QLabel#preview-placeholder {
    color: #94A3B8;
    font-size: 13px;
    background-color: #F8FAFC;
    border: 2px dashed #E2E8F0;
    border-radius: 8px;
    padding: 40px;
}
