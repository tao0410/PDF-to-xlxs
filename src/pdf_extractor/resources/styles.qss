/* PDF信息提取工具 v2.2 — 对齐 UI-demo-1.html 设计 token（字体+1px适配PyQt5渲染） */

/* ═══════════ Global ═══════════ */
* {
    font-family: "Microsoft YaHei", "微软雅黑", "Segoe UI", sans-serif;
    font-size: 15px;
    color: #334155;
}

QMainWindow { background-color: #F8FAFC; }
QDialog { background-color: #FFFFFF; }

/* ═══════════ Typography ═══════════ */
QLabel { color: #334155; background: transparent; }
QLabel#section-title { font-size: 15px; font-weight: 600; color: #0F172A; }
QLabel#card-title { font-size: 17px; font-weight: 600; color: #0F172A; }
QLabel#hint-text { color: #64748B; font-size: 13px; }
QLabel#stat-value { font-size: 19px; font-weight: 700; color: #0F172A; }
QLabel#stat-label { font-size: 13px; color: #64748B; }

/* ═══════════ Cards ═══════════ */
QFrame#card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    padding: 16px;
}
QFrame#card-compact {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 16px;
}
QFrame#stat-card {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #F8FAFC, stop:1 #F1F5F9);
    border-radius: 10px;
    padding: 16px 20px;
}

/* ═══════════ Banners ═══════════ */
QLabel#warning-banner {
    background: #FEF3C7; color: #92400E;
    border-radius: 6px; padding: 12px 16px; font-size: 14px;
}
QLabel#success-banner {
    background: #F0FDF4; color: #166534;
    border-radius: 6px; padding: 12px 16px; font-size: 14px;
}
QLabel#danger-banner {
    background: #FEE2E2; color: #991B1B;
    border-radius: 6px; padding: 12px 16px; font-size: 14px;
}

/* ═══════════ Buttons ═══════════ */
QPushButton {
    background: #FFFFFF; border: 1px solid #E2E8F0;
    border-radius: 6px; padding: 10px 20px;
    color: #334155; font-size: 15px; font-weight: 600;
}
QPushButton:hover { background: #F8FAFC; border-color: #CBD5E1; }
QPushButton:pressed { background: #E2E8F0; }
QPushButton:disabled { background: #F1F5F9; color: #94A3B8; }

QPushButton#btn-primary {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #15803D, stop:1 #16A34A);
    color: #FFFFFF;
    border: none; padding: 10px 20px;
}
QPushButton#btn-primary:hover { background: #16A34A; }
QPushButton#btn-primary:pressed { background: #166534; }
QPushButton#btn-primary:disabled { background: #86EFAC; color: #FFFFFF; }

QPushButton#btn-secondary {
    background: #FFFFFF; border: 1px solid #E2E8F0;
    color: #334155; padding: 10px 20px;
}
QPushButton#btn-secondary:hover { background: #F8FAFC; border-color: #CBD5E1; }

QPushButton#btn-ghost {
    background: transparent; border: 1px solid transparent;
    color: #64748B; padding: 10px 20px;
}
QPushButton#btn-ghost:hover { background: #F8FAFC; color: #64748B; }

QPushButton#btn-danger {
    background: #DC2626; color: #FFFFFF; border: none;
}
QPushButton#btn-danger:hover { background: #EF4444; }

QPushButton#btn-small {
    padding: 6px 14px; font-size: 13px;
}

/* ═══════════ Inputs ═══════════ */
QLineEdit, QComboBox, QSpinBox {
    border: 1px solid #E2E8F0; border-radius: 6px;
    padding: 0px 14px; min-height: 36px;
    background: #FFFFFF; color: #334155;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border: 1px solid #15803D; }
QComboBox::drop-down { border: none; }
QComboBox QAbstractItemView {
    border: 1px solid #E2E8F0; background: #FFFFFF;
    selection-background-color: #DCFCE7; selection-color: #0F172A;
}

/* ═══════════ Tables ═══════════ */
QTableWidget {
    border: 1px solid #CBD5E1; border-radius: 10px;
    background: #FFFFFF; gridline-color: #E2E8F0;
    selection-background-color: #DCFCE7; selection-color: #0F172A;
}
QTableWidget::item {
    padding: 10px 16px; min-height: 26px; font-size: 15px;
}
QHeaderView::section {
    background: #15803D; color: #FFFFFF;
    font-weight: 700; font-size: 14px;
    border: none; border-bottom: 1px solid #166534;
    padding: 10px 16px;
    text-align: left;
}

/* ═══════════ Progress Bar ═══════════ */
QProgressBar {
    border: none; border-radius: 4px;
    background: #F1F5F9; height: 8px;
    font-size: 12px; color: transparent;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #15803D, stop:1 #22C55E);
    border-radius: 4px;
}

/* ═══════════ Group Box ═══════════ */
QGroupBox {
    border: 1px solid #E2E8F0; border-radius: 8px;
    margin-top: 12px; padding: 16px; padding-top: 28px;
    font-weight: 600; color: #0F172A; background: #FFFFFF;
}
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; padding: 4px 12px; }

/* ═══════════ Scrollbar ═══════════ */
QScrollBar:vertical { background: transparent; width: 8px; }
QScrollBar::handle:vertical { background: #CBD5E1; border-radius: 4px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #94A3B8; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 8px; }
QScrollBar::handle:horizontal { background: #CBD5E1; border-radius: 4px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ═══════════ Toolbar ═══════════ */
QFrame#toolbar {
    background: #FFFFFF;
    border-top: 1px solid #F1F5F9;
    padding: 12px 24px;
}

/* ═══════════ Tags ═══════════ */
QLabel#record-tag {
    background: #DCFCE7; color: #15803D;
    border-radius: 9999px; padding: 3px 12px;
    font-size: 13px; font-weight: 500;
}

/* ═══════════ Radio Cards ═══════════ */
QFrame#radio-card {
    background: #FFFFFF; border: 1px solid #E2E8F0;
    border-radius: 8px; padding: 12px 16px;
}
QFrame#radio-card-selected {
    background: #F0FDF4; border: 1px solid #15803D;
    border-radius: 8px; padding: 12px 16px;
}
